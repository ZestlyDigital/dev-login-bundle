{
    "name": "zestly/dev-login-bundle",
    "description": "Log in as any user without a password in your Symfony dev environment. Built for humans, and for coding agents that can't type your password.",
    "type": "symfony-bundle",
    "keywords": ["symfony", "bundle", "dev", "login", "authentication", "developer-experience", "testing", "ai-agent"],
    "homepage": "https://github.com/ZestlyDigital/dev-login-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Zestly Digital",
            "homepage": "https://zestlydigital.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0",
        "symfony/routing": "^7.0 || ^8.0",
        "symfony/security-bundle": "^7.0 || ^8.0",
        "symfony/security-core": "^7.0 || ^8.0",
        "symfony/security-http": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/browser-kit": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/phpunit-bridge": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Zestly\\DevLoginBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zestly\\DevLoginBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "ci": ["@phpstan", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
